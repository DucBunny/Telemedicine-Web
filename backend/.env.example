PORT=8080
NODE_ENV=development

# Application timezone (IANA format) where the clinic operates
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# TiDB Cloud configuration
DB_PORT=your-port
DB_HOST=your-host
DB_USER=your-user
DB_PASSWORD=your-password

DB_NAME=your_database_name
DB_DIALECT=mysql
DB_LOGGING=false

# MongoDB Atlas configuration
MONGODB_DB_NAME=your_nosql_database_name
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password
MONGODB_CLUSTER=your_mongodb_cluster
MONGODB_HOST=your_mongodb_host
MONGODB_PORT=your_mongodb_port

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ROOT_FOLDER=your_root_folder

# JWT configuration
JWT_SECRET=your-jwt-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRE=7d

# MQTT configuration
MQTT_BROKER=mqtt://broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=+/server

# Resend (email) configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=MedCare <onboarding@resend.dev>

# Redis configuration (Cloud Redis or local)
# Cloud Redis: rediss://username:password@host:port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false

# ZEGOCLOUD configuration
ZEGO_APP_ID=your-zego-app-id
ZEGO_SERVER_SECRET=your-zego-server-secret

# Frontend URL
BASE_URL_FRONTEND=http://localhost:3000

# Application configuration

# Thời gian cache throttle alert (30 phút)
ALERT_THROTTLE_TTL_SEC=1800
# Kích thước gói ECG (187 điểm)
ECG_PACKET_SIZE=187